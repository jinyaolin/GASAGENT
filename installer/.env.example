# 複製成 .env（chmod 600）再改。
# 對外網址（Caddy 反代 /agent → 本服務；OAuth redirect_uri = BASE_URL/oauth/callback，要登記在 Google OAuth client）
BASE_URL=https://zaistudio.tw/agent
# 監聽（放在 Caddy 後面，只聽本機）
HOST=127.0.0.1
PORT=8790
# 取件碼暫存目錄（pickups.json，0600）
DATA_DIR=./data
# Google OAuth client（類型「網頁應用程式」，已授權的重新導向 URI = BASE_URL/oauth/callback）。只放這裡，不進 repo。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 程式碼來源（repo 根目錄要有 scripts/release.sh 產生的 release.json）
RELEASE_REPO=jinyaolin/GASAGENT
RELEASE_REF=main
# 取件碼有效小時數（1–168）
PICKUP_TTL_HOURS=24
